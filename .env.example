OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional server runtime
PORT=3000
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_VOICE=marin
REALTIME_SESSION_TTL_SECONDS=300

# Comma-separated origins allowed to create browser client secrets.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://translate.christian-galler.de

# Simple in-memory rate limit for /interpreter-session per client IP.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=20
